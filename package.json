{
  "name": "loan-tracker",
  "version": "1.0.0",
  "description": "A comprehensive loan tracking application built with HTML, CSS, and jQuery",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:www": "node scripts/build-www.js",
    "sync:android": "npm run build:www && npx cap sync android",
    "open:android": "npx cap open android",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "loan",
    "tracker",
    "finance",
    "html",
    "css",
    "jquery"
  ],
